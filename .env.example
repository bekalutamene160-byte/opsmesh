# =============================================================================
# OPSMESH .env.example -- copy to .env and fill in. NEVER commit .env.
# All vars are prefixed with OPSMESH_ (matches opsmesh/config.py).
# =============================================================================

# --- Access mode (Stage B Phase 5) ---
# single_user_demo (default): NO authentication. The dashboard opens directly
#   at /. All unauthenticated access is bound server-side to DEMO_WORKSPACE_ID.
#   Email sends are restricted to EMAIL_TEST_RECIPIENT; CRM mutations are
#   governed by CRM_DEMO_MODE. This is an explicitly UNAUTHENTICATED DEMO --
#   NOT secure for multi-tenant production.
# multi_user: requires Google OAuth + session JWT; per-user workspaces.
OPSMESH_ACCESS_MODE=single_user_demo
OPSMESH_DEMO_WORKSPACE_ID=default

# --- Demo-mode safety guards (Stage B Phase 1) ---
# EMAIL_TEST_RECIPIENT: in single_user_demo mode, SendingSpecialist asserts
#   the recipient equals this address before any real send. Set to your
#   Resend account's verified test recipient.
OPSMESH_EMAIL_TEST_RECIPIENT=
# CRM_DEMO_MODE: governs live HubSpot mutations.
#   read_only (default): skip live CRM call, record SKIPPED_DEMO outbox op.
#   disabled: no CRM step at all.
#   live: calls the real CRM (NOT recommended for public demo).
OPSMESH_CRM_DEMO_MODE=read_only

# --- Database (SQLite for dev, Postgres for production) ---
# Option A: SQLite (single-instance dev/test)
OPSMESH_DATABASE_PATH=./opsmesh.db
# Option B: Postgres (production -- takes precedence over database_path)
# Format: postgresql://user:password@host:port/dbname
# OPSMESH_DATABASE_URL=postgresql://opsmesh:password@localhost:5432/opsmesh
OPSMESH_PRODUCTION_MODE=false

# --- LLM provider (Groq GPT-OSS 120B -- Llama 3.3 is Enterprise-only) ---
# Groq free tier: 250K TPM, 1K RPM (https://console.groq.com/keys)
OPSMESH_LLM_PROVIDER=mock                # mock | groq
OPSMESH_LLM_API_KEY=                     # gsk_... (required if LLM_PROVIDER=groq)
OPSMESH_LLM_DEFAULT_MODEL=openai/gpt-oss-120b  # Groq's recommended free-tier model

# --- CRM provider (mock for dev/CI; hubspot for prod) ---
OPSMESH_CRM_PROVIDER=mock                # mock | hubspot
OPSMESH_CRM_API_KEY=                     # HubSpot Private App token (pat-...)

# --- Research provider (mock for dev/CI; exa for prod) ---
OPSMESH_RESEARCH_PROVIDER=mock            # mock | exa
OPSMESH_EXA_API_KEY=                      # Exa API key (https://dashboard.exa.ai)

# --- Email provider (Resend -- https://resend.com/api-keys) ---
# email_kill_switch=true blocks ALL real sends. Flip to false in production
# AFTER you've verified the sender domain in Resend AND set EMAIL_TEST_RECIPIENT.
OPSMESH_EMAIL_PROVIDER=mock              # mock | resend
OPSMESH_EMAIL_API_KEY=                   # re_... (Resend API key)
OPSMESH_EMAIL_KILL_SWITCH=true           # safety: true = block all real sends

# --- Webhook (HMAC on raw body -- verified on RAW bytes, never re-serialized) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production_mode (startup fails closed without a real secret).
OPSMESH_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Tally webhook HMAC secret. Stage B Phase 1: verification is UNCONDITIONAL
# when set; production_mode requires this to be a real value (startup fails).
OPSMESH_TALLY_WEBHOOK_SECRET=change-me-for-tally-webhook

# --- Public embed token (for the drop-in widget on static sites) ---
# A publishable key (like Stripe's pk_live_). Safe to expose in browser JS:
# the /api/v1/public/lead endpoint can ONLY create leads — never read, send,
# or approve. CORS is open for this path only. Leave empty to disable.
# Example: pk_live_a1b2c3d4e5f6...
OPSMESH_PUBLIC_TOKEN=

# --- Session JWT signing (multi_user mode only) ---
# Used to sign our own session JWTs (HS256) after Google OAuth verification.
# Only required when ACCESS_MODE=multi_user. Ignored in single_user_demo mode.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSMESH_SESSION_SECRET=change-me-to-another-long-random-string

# --- Google OAuth (multi_user mode only) ---
# Stage B Phase 5: Google OAuth is REMOVED from the default demo deployment.
# These are only used when OPSMESH_ACCESS_MODE=multi_user. In single_user_demo
# mode they are ignored and the OAuth router is not mounted.
# Create credentials at: https://console.cloud.google.com/apis/credentials
OPSMESH_GOOGLE_OAUTH_CLIENT_ID=
OPSMESH_GOOGLE_OAUTH_CLIENT_SECRET=

# --- CORS (Stage B Phase 1) ---
# Comma-separated list of allowed origins for the frontend.
# The frontend is served same-origin at /ui, so the demo needs NO CORS origins.
# Wildcard "*" is rejected in single_user_demo mode for safety.
# Leave empty for same-origin only (recommended for the demo).
OPSMESH_CORS_ALLOWED_ORIGINS=

# --- Observability (ADR-006) ---
OPSMESH_OBS_BACKEND=local               # local | otlp | console
OPSMESH_OTEL_EXPORTER_OTLP_ENDPOINT=    # required if OBS_BACKEND=otlp

# --- Engineering Contract values ---
OPSMESH_CONCURRENCY_LOCAL=4
OPSMESH_MAX_STEPS=15
OPSMESH_MAX_TOOL_CALLS=12
OPSMESH_MAX_TOKENS_PRO=8000
OPSMESH_MAX_TOKENS_FLASH=12000
OPSMESH_MAX_COST_USD=0.05
OPSMESH_MAX_RUN_SECONDS=60
OPSMESH_APPROVAL_TIMEOUT_HOURS=24
OPSMESH_JOB_LEASE_SECONDS=300

# --- Workspace defaults (seed) ---
OPSMESH_WORKSPACE_OWNER_EMAIL=owner@example.com
# Resend's pre-verified test sender -- works with no custom domain.
# Format: "Display Name <localpart@resend.dev>". Override with a verified
# custom domain for production outreach.
OPSMESH_WORKSPACE_SENDER_IDENTITY="OpsMesh <onboarding@resend.dev>"
