# =============================================================================
# OPSMESH .env.example -- copy to .env and fill in. NEVER commit .env.
# All vars are prefixed with OPSMESH_ (matches opsmesh/config.py).
# =============================================================================

# --- Database (Phase 7: SQLite for dev, Postgres for production) ---
# Option A: SQLite (single-instance dev/test)
OPSMESH_DATABASE_PATH=./opsmesh.db
# Option B: Postgres (production -- takes precedence over database_path)
# Format: postgresql://user:password@host:port/dbname
# OPSMESH_DATABASE_URL=postgresql://opsmesh:password@localhost:5432/opsmesh
OPSMESH_PRODUCTION_MODE=false

# --- LLM provider (Phase 7: Groq GPT-OSS 120B -- Llama 3.3 is Enterprise-only) ---
# Groq free tier: 250K TPM, 1K RPM (https://console.groq.com/keys)
OPSMESH_LLM_PROVIDER=mock                # mock | groq
OPSMESH_LLM_API_KEY=                     # gsk_... (required if LLM_PROVIDER=groq)
OPSMESH_LLM_DEFAULT_MODEL=openai/gpt-oss-120b  # Groq's recommended free-tier model

# --- CRM provider (mock for dev/CI; hubspot for prod) ---
OPSMESH_CRM_PROVIDER=mock                # mock | hubspot
OPSMESH_CRM_API_KEY=                     # HubSpot Private App token (pat-...)

# --- Research provider (mock for dev/CI; exa for prod) ---
OPSMESH_RESEARCH_PROVIDER=mock            # mock | exa
OPSMESH_EXA_API_KEY=                      # Exa API key (https://dashboard.exa.ai)

# --- Email provider (Resend -- https://resend.com/api-keys) ---
# ?? email_kill_switch=true blocks ALL real sends. Flip to false in production
# AFTER you've verified the sender domain in Resend.
OPSMESH_EMAIL_PROVIDER=mock              # mock | resend
OPSMESH_EMAIL_API_KEY=                   # re_... (Resend API key)
OPSMESH_EMAIL_KILL_SWITCH=true           # safety: true = block all real sends
# OPSMESH_EMAIL_FROM=you@yourdomain.com   # required for real sends (must be a verified domain)

# --- Webhook (HMAC on raw body) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSMESH_WEBHOOK_SECRET=change-me-to-a-long-random-string
OPSMESH_TALLY_WEBHOOK_SECRET=change-me-for-tally-webhook

# --- Session JWT signing (Phase 6) ---
# Used to sign our own session JWTs (HS256) after Google OAuth verification.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSMESH_SESSION_SECRET=change-me-to-another-long-random-string

# --- Google OAuth (Phase 6) ---
# When configured, the frontend shows a "Sign in with Google" button.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add your frontend origin to "Authorized JavaScript origins".
OPSMESH_GOOGLE_OAUTH_CLIENT_ID=
OPSMESH_GOOGLE_OAUTH_CLIENT_SECRET=

# --- CORS (Phase 4) ---
# Comma-separated list of allowed origins for the frontend.
# In production, set this to the exact origin of your frontend deployment.
OPSMESH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Observability (ADR-006) ---
OPSMESH_OBS_BACKEND=local               # local | otlp | console
OPSMESH_OTEL_EXPORTER_OTLP_ENDPOINT=    # required if OBS_BACKEND=otlp

# --- Engineering Contract values ---
OPSMESH_CONCURRENCY_LOCAL=4
OPSMESH_MAX_STEPS=15
OPSMESH_MAX_TOOL_CALLS=12
OPSMESH_MAX_TOKENS_PRO=8000
OPSMESH_MAX_TOKENS_FLASH=12000
OPSMESH_MAX_COST_USD=0.05
OPSMESH_MAX_RUN_SECONDS=60
OPSMESH_APPROVAL_TIMEOUT_HOURS=24
OPSMESH_JOB_LEASE_SECONDS=300

# --- Workspace defaults (seed) ---
OPSMESH_WORKSPACE_OWNER_EMAIL=owner@example.com
OPSMESH_WORKSPACE_SENDER_IDENTITY="Bekalu <bekalu@opsmesh.dev>"
